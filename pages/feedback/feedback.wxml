<view class="page">
  <view class="hero">
    <view class="hero-eyebrow">用户反馈 · {{user.name}}</view>
    <view class="hero-title">反馈与报错</view>
    <view class="hero-sub">描述你遇到的问题或想要的功能，教师端可以查看</view>
  </view>

  <view class="panel">
    <view class="panel-title">反馈类型</view>
    <view class="type-row">
      <view
        class="type-chip {{type === item.key ? 'active' : ''}}"
        wx:for="{{types}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onType"
      >{{item.label}}</view>
    </view>

    <view class="field-label">问题描述</view>
    <textarea
      class="fb-textarea"
      value="{{content}}"
      bindinput="onContent"
      maxlength="300"
      placeholder="请描述具体问题或建议，例如：预约后按钮没有反应、希望增加夜间时段等（至少 5 个字）"
      placeholder-class="ph"
    />
    <view class="fb-count">{{count}} / 300</view>

    <view class="field-label">联系方式（选填）</view>
    <input
      class="fb-input"
      value="{{contact}}"
      bindinput="onContact"
      placeholder="微信号 / 手机号，方便老师联系你"
      placeholder-class="ph"
    />

    <button class="submit-btn" bindtap="submit" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '提交反馈'}}
    </button>

    <view class="fb-tip">演示版反馈保存在本机，教师端「反馈」标签页可查看。</view>
  </view>

  <view class="safe"></view>
</view>
