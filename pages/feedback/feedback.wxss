.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.hero {
  padding: 40rpx 36rpx 44rpx;
  background: linear-gradient(150deg, #0F2A5C 0%, #1D4ED8 65%, #2F7BE8 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.hero-eyebrow {
  font-size: 22rpx;
  color: #BFD4FF;
  letter-spacing: 1rpx;
}

.hero-title {
  margin-top: 14rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #C6D8FF;
}

/* 类型选择 */
.type-row {
  display: flex;
  margin: 18rpx 0 8rpx;
}

.type-chip {
  flex: 1;
  height: 68rpx;
  margin-right: 14rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 24rpx;
  color: #6B7A90;
  background: #F5F8FC;
  border: 1rpx solid #E7ECF5;
  border-radius: 34rpx;
}

.type-chip:last-child {
  margin-right: 0;
}

.type-chip.active {
  color: #FFFFFF;
  background: linear-gradient(120deg, #1D4ED8, #3B82F6);
  border-color: transparent;
  box-shadow: 0 8rpx 18rpx rgba(29, 78, 216, 0.22);
}

/* 表单 */
.field-label {
  margin-top: 26rpx;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #7A879C;
}

.fb-textarea {
  width: 100%;
  height: 220rpx;
  padding: 22rpx;
  font-size: 26rpx;
  line-height: 1.6;
  background: #F5F8FC;
  border: 1rpx solid #E7ECF5;
  border-radius: 16rpx;
}

.fb-count {
  margin-top: 8rpx;
  text-align: right;
  font-size: 18rpx;
  color: #A0AABC;
}

.fb-input {
  height: 80rpx;
  padding: 0 22rpx;
  font-size: 26rpx;
  background: #F5F8FC;
  border: 1rpx solid #E7ECF5;
  border-radius: 16rpx;
}

.ph {
  color: #B3BDCC;
}

.submit-btn {
  height: 88rpx;
  margin-top: 32rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(120deg, #1D4ED8, #3B82F6);
  border-radius: 44rpx;
  box-shadow: 0 12rpx 24rpx rgba(29, 78, 216, 0.26);
}

.submit-btn[disabled] {
  opacity: 0.7;
}

.fb-tip {
  margin-top: 18rpx;
  text-align: center;
  font-size: 18rpx;
  color: #A0AABC;
}

.safe {
  height: 20rpx;
}
