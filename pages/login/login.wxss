.wrap {
  min-height: 100vh;
  background: #F4F6FB;
}

.bg {
  position: relative;
  height: 480rpx;
  padding: 96rpx 56rpx 0;
  background: linear-gradient(150deg, #0F2A5C 0%, #1D4ED8 62%, #2F7BE8 100%);
  border-radius: 0 0 48rpx 48rpx;
  overflow: hidden;
}

.circle {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.18);
}

.c1 {
  width: 320rpx;
  height: 320rpx;
  right: -80rpx;
  top: -60rpx;
  background: rgba(255, 255, 255, 0.06);
}

.c2 {
  width: 180rpx;
  height: 180rpx;
  right: 120rpx;
  bottom: -60rpx;
}

.brand {
  position: relative;
  z-index: 2;
}

.brand-mark {
  display: inline-block;
  padding: 6rpx 14rpx;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #BFD4FF;
  border: 1rpx solid rgba(191, 212, 255, 0.5);
  border-radius: 8rpx;
}

.brand-title {
  margin-top: 24rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.brand-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #C6D8FF;
}

.card {
  position: relative;
  z-index: 3;
  margin: -120rpx 40rpx 0;
  padding: 32rpx 40rpx 40rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 20rpx 48rpx rgba(15, 42, 92, 0.14);
}

.tabs {
  display: flex;
  padding: 6rpx;
  margin-bottom: 32rpx;
  background: #F2F5FA;
  border-radius: 16rpx;
}

.tab {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 26rpx;
  color: #7A879C;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.tab.active {
  background: #FFFFFF;
  color: #1D4ED8;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(23, 43, 77, 0.08);
}

.field {
  margin-bottom: 26rpx;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: #7A879C;
}

.input {
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #16243D;
  background: #F7F9FC;
  border: 1rpx solid #E7ECF5;
  border-radius: 16rpx;
}

.ph {
  color: #B3BDCC;
}

.submit {
  height: 92rpx;
  margin-top: 36rpx;
  line-height: 92rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(120deg, #1D4ED8, #3B82F6);
  border-radius: 46rpx;
  box-shadow: 0 14rpx 28rpx rgba(29, 78, 216, 0.3);
}

.switch {
  margin-top: 28rpx;
  text-align: center;
  font-size: 24rpx;
  color: #1D4ED8;
}

.hint {
  margin: 32rpx 40rpx 60rpx;
  padding: 20rpx 24rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #8A96A8;
  background: #EEF2F9;
  border-radius: 14rpx;
}
