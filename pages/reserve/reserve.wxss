.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ---------- 顶部 ---------- */
.hero {
  position: relative;
  padding: 40rpx 36rpx 44rpx;
  background: linear-gradient(150deg, #0F2A5C 0%, #1D4ED8 65%, #2F7BE8 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.hero-eyebrow {
  font-size: 22rpx;
  color: #BFD4FF;
  letter-spacing: 1rpx;
}

.hero-title {
  margin-top: 14rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #C6D8FF;
}

.hero-link {
  position: absolute;
  right: 36rpx;
  top: 44rpx;
  padding: 10rpx 22rpx;
  font-size: 20rpx;
  color: #DCE7FF;
  border: 1rpx solid rgba(220, 231, 255, 0.45);
  border-radius: 24rpx;
}

.hint {
  font-size: 20rpx;
  color: #8A96A8;
}

/* ---------- 日期 ---------- */
.date-scroll {
  white-space: nowrap;
}

.date-chip {
  display: inline-block;
  width: 112rpx;
  margin-right: 14rpx;
  padding: 16rpx 0;
  text-align: center;
  background: #F5F8FC;
  border: 1rpx solid #E7ECF5;
  border-radius: 16rpx;
}

.date-chip.active {
  background: linear-gradient(140deg, #1D4ED8, #3B82F6);
  border-color: transparent;
  box-shadow: 0 8rpx 18rpx rgba(29, 78, 216, 0.28);
}

.dc-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #2C3E5C;
}

.dc-md {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #8A96A8;
}

.date-chip.active .dc-label,
.date-chip.active .dc-md {
  color: #FFFFFF;
}

/* ---------- 时段 ---------- */
.slot-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -4rpx;
}

.slot {
  width: calc((100% - 56rpx) / 4);
  height: 78rpx;
  margin: 4rpx;
  border-radius: 14rpx;
  background: #F5F8FC;
  border: 1rpx solid #E7ECF5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.slot-time {
  font-size: 24rpx;
  font-weight: 600;
  color: #2C3E5C;
}

.slot-tag {
  font-size: 16rpx;
  color: #A0AABC;
}

.slot.active {
  background: linear-gradient(140deg, #1D4ED8, #3B82F6);
  border-color: transparent;
  box-shadow: 0 8rpx 18rpx rgba(29, 78, 216, 0.25);
}

.slot.active .slot-time {
  color: #FFFFFF;
}

.slot.active .slot-tag {
  color: #DCE7FF;
}

.slot.disabled {
  opacity: 0.45;
}

/* ---------- 我的预约 ---------- */
.mine-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 28rpx 0;
  padding: 26rpx 30rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border-left: 8rpx solid #1D4ED8;
  box-shadow: 0 12rpx 32rpx rgba(23, 43, 77, 0.07);
}

.mine-label {
  font-size: 20rpx;
  color: #7A879C;
}

.mine-main {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1D4ED8;
}

.mine-btn {
  padding: 14rpx 30rpx;
  font-size: 22rpx;
  color: #C9362B;
  background: #FFF1F0;
  border-radius: 30rpx;
}

/* ---------- 已被预约的座位 ---------- */
.dot.book {
  background: #F2B441;
}

.seat.state-booked {
  background: #FFF8E6;
  border-color: #FFE2A8;
}

.seat.state-booked .seat-no {
  color: #B26A00;
}

.seat.state-booked .seat-tag {
  color: #C98A00;
}

.safe {
  height: 20rpx;
}
