.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ---------- 顶部 ---------- */
.hero {
  padding: 40rpx 36rpx 48rpx;
  background: linear-gradient(150deg, #0F2A5C 0%, #1D4ED8 65%, #2F7BE8 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.hero-eyebrow {
  font-size: 22rpx;
  color: #BFD4FF;
  letter-spacing: 1rpx;
}

.hero-title {
  margin-top: 14rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #C6D8FF;
}

.logout {
  padding: 10rpx 20rpx;
  font-size: 20rpx;
  color: #DCE7FF;
  border: 1rpx solid rgba(220, 231, 255, 0.45);
  border-radius: 24rpx;
}

.stats {
  display: flex;
  margin-top: 40rpx;
  padding: 24rpx 0;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 20rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat + .stat {
  border-left: 1rpx solid rgba(255, 255, 255, 0.16);
}

.num {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
}

.num.occ { color: #FFB4AD; }
.num.bad { color: #C9D4E5; }

.lab {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #C6D8FF;
}

/* ---------- 快捷入口 ---------- */
.quick {
  display: flex;
  margin: 24rpx 28rpx 0;
}

.quick-item {
  flex: 1;
  padding: 22rpx 14rpx;
  margin-right: 12rpx;
  border-radius: 20rpx;
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(23, 43, 77, 0.12);
}

.quick-item:last-child {
  margin-right: 0;
}

.q-blue {
  background: linear-gradient(140deg, #1D4ED8, #3B82F6);
}

.q-green {
  background: linear-gradient(140deg, #0E7A46, #16A34A);
}

.q-purple {
  background: linear-gradient(140deg, #4C1D95, #7C3AED);
}

.q-orange {
  background: linear-gradient(140deg, #B45309, #F59E0B);
}

.q-title {
  font-size: 24rpx;
  font-weight: 600;
}

.q-sub {
  margin-top: 6rpx;
  font-size: 17rpx;
  opacity: 0.82;
}

/* ---------- 签到门禁 ---------- */
.gate {
  margin: 24rpx 28rpx 0;
  padding: 30rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #FFE0B2;
  box-shadow: 0 12rpx 32rpx rgba(23, 43, 77, 0.06);
}

.gate.ok {
  border-color: #C8E6D2;
  background: #F7FCF9;
}

.gate-top {
  display: flex;
  align-items: center;
}

.gate-badge {
  padding: 4rpx 14rpx;
  margin-right: 14rpx;
  font-size: 20rpx;
  color: #B26A00;
  background: #FFF4E0;
  border-radius: 8rpx;
}

.gate-badge.ok {
  color: #0F9D58;
  background: #E7F6EC;
}

.gate-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #16243D;
}

.gate-sub {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7A879C;
}

.gate-btn {
  height: 84rpx;
  margin-top: 24rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(120deg, #1D4ED8, #3B82F6);
  border-radius: 42rpx;
  box-shadow: 0 12rpx 24rpx rgba(29, 78, 216, 0.24);
}

.gate-link {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #1D4ED8;
}

/* ---------- 我的座位 ---------- */
.my-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 28rpx 0;
  padding: 28rpx 30rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border-left: 8rpx solid #1D4ED8;
  box-shadow: 0 12rpx 32rpx rgba(23, 43, 77, 0.07);
}

.my-label {
  font-size: 20rpx;
  color: #7A879C;
}

.my-code {
  margin-top: 6rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #1D4ED8;
}

.my-meta {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8A96A8;
}

.my-btn {
  padding: 14rpx 34rpx;
  font-size: 24rpx;
  color: #C9362B;
  background: #FFF1F0;
  border-radius: 34rpx;
}

.safe {
  height: 20rpx;
}
